{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The organizations the reader is a member of. -#}
{%- block page_body -%}
    {%- if organizations is empty -%}
        <p class="fallback">{{ '@page::empty' | trans }}</p>
    {%- else -%}
        {{ data_table([
            { key: 'name', label: '@page::column.name' | trans },
            { key: 'country', label: '@page::column.country' | trans },
            { key: 'vat_number', label: '@page::column.vat_number' | trans },
        ], organizations|map(organization => {
            href: path('organization_show', { id: organization.id }),
            name: organization.name,
            country: organization.country ? organization.country.isoAlpha2Code : '',
            vat_number: organization.vatNumber ?? '',
        }), { row_link: { key: 'href' } }) }}
    {%- endif -%}
{%- endblock -%}
