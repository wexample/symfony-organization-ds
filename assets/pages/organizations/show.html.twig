{%- extends '@WexampleSymfonyOrganizationDsBundle/layouts/organization/layout.html.twig' -%}

{%- set page_title = organization.name -%}

{#- An organization at a glance: who it is, and where it works and worked from. -#}
{%- block page_body -%}
    {%- set identity = 'WexampleSymfonyOrganizationDsBundle.common.identity::' -%}
    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-label">{{ '@page::identity' | trans }}</span>
        </div>
        <div class="block--body">
            {#- What is known of it only: an identifier never given is no line. -#}
            {{ properties([
                { key: '@page::nature' | trans, value: ('@page::nature_' ~ (organization.individual ? 'individual' : 'company')) | trans },
                { key: (identity ~ 'legal_form') | trans, value: organization.legalForm },
                { key: (identity ~ 'legal_identifier') | trans, value: organization.legalIdentifier },
                { key: (identity ~ 'vat_number') | trans, value: organization.vatNumber },
                { key: '@page::country' | trans, value: organization.country ? organization.country.isoAlpha2Code|country_name(app.request.locale) : null },
                { key: (identity ~ 'email') | trans, value: organization.email },
                { key: (identity ~ 'phone') | trans, value: organization.phone },
                { key: (identity ~ 'website') | trans, value: organization.website ? '<a href="' ~ organization.website|e('html_attr') ~ '" target="_blank" rel="noopener">' ~ organization.website|e ~ '</a>' : null, html: true, break: true },
            ]|filter(item => item.value), { columns: true }) }}
        </div>
    </section>

    {%- if organization.establishments is not empty -%}
        <h2>{{ '@page::establishments.title' | trans }}</h2>
        {{ data_table([
            { key: 'identifier', label: '@page::establishments.identifier' | trans },
            { key: 'address', label: '@page::establishments.address' | trans },
            { key: 'opened', label: '@page::establishments.opened' | trans, cell: 'html' },
            { key: 'closed', label: '@page::establishments.closed' | trans, cell: 'html' },
            { key: 'role', label: '@page::establishments.role' | trans, cell: 'html' },
        ], organization.establishments|reverse|map(establishment => {
            identifier: establishment.legalIdentifier ?? '',
            address: establishment.address ? [establishment.address.postalAddress, [establishment.address.postCode, establishment.address.city]|filter(v => v)|join(' ')]|filter(v => v)|join(', ') : '',
            opened: establishment.dateOpened ? date_display(establishment.dateOpened, 'date_short') : '',
            closed: establishment.dateClosed ? date_display(establishment.dateClosed, 'date_short') : marker('success', '@page::establishments.open' | trans, { compact: true }),
            role: establishment.headOffice ? marker('neutral', '@page::establishments.head_office' | trans, { compact: true }) : '',
        })) }}
    {%- endif -%}
{%- endblock -%}
